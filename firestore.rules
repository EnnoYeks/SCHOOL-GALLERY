rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.uid != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function signedInAny() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAuthor() {
      return signedIn()
        && resource.data.authorId is string
        && resource.data.authorId == request.auth.uid;
    }

    function isAuthorOnCreate() {
      return signedIn()
        && request.resource.data.authorId is string
        && request.resource.data.authorId == request.auth.uid;
    }

    function optionalString(field, max) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= max);
    }

    function optionalBool(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] is bool;
    }

    function optionalList(field, maxItems) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is list
            && request.resource.data[field].size() <= maxItems);
    }

    function bumpByOne(field) {
      return !(field in request.resource.data)
        || !(field in resource.data)
        || request.resource.data[field] == resource.data[field]
        || request.resource.data[field] == resource.data[field] + 1
        || request.resource.data[field] == resource.data[field] - 1;
    }

    function engagementOnly() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'comments', 'shares', 'likeCount', 'commentCount'])
        && bumpByOne('likes')
        && bumpByOne('comments')
        && bumpByOne('shares')
        && bumpByOne('likeCount')
        && bumpByOne('commentCount');
    }

    function campusKeyOk(key) {
      return key in [
        'campus_sports',
        'campus_choir',
        'campus_s4',
        'campus_prefects',
        'campus_announce'
      ];
    }

    function isChatMember() {
      return signedIn()
        && resource.data.memberIds is list
        && request.auth.uid in resource.data.memberIds;
    }

    match /users/{uid} {
      allow read: if signedIn() || isSelf(uid);

      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid
        && optionalString('fullName', 80)
        && optionalString('name', 80)
        && optionalString('username', 24)
        && optionalString('email', 120)
        && optionalString('bio', 160)
        && optionalString('headline', 80)
        && optionalString('classYear', 40)
        && optionalString('house', 40)
        && optionalString('role', 40)
        && optionalString('photoURL', 200000)
        && optionalString('avatar', 200000)
        && optionalString('coverURL', 200000)
        && optionalString('cover', 200000)
        && optionalString('phone', 40)
        && optionalString('whatsapp', 40)
        && optionalString('studentId', 40)
        && optionalString('location', 80)
        && optionalString('website', 200)
        && optionalString('instagram', 40)
        && optionalString('tiktok', 40)
        && optionalString('pronouns', 40)
        && optionalList('interests', 20)
        && optionalBool('isAnonymous')
        && optionalBool('allowMessages')
        && optionalBool('privateAccount')
        && optionalBool('showEmail')
        && optionalBool('showPhone')
        && optionalBool('showStudentId')
        && optionalBool('showActivity');

      allow delete: if false;

      match /private/{docId} {
        allow read, create, update: if isSelf(uid) && docId == 'contact';
        allow delete: if isSelf(uid);
      }
    }

    match /userIndex/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.field == 'username'
        && request.resource.data.value is string
        && request.resource.data.value.size() >= 3
        && request.resource.data.value.size() <= 24;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.field == 'username';

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /posts/{id} {
      allow read: if true;
      allow create: if isAuthorOnCreate()
        && optionalString('text', 5000)
        && optionalString('title', 200)
        && optionalString('type', 40)
        && optionalList('destinations', 20);
      allow update: if isAuthor() || engagementOnly();
      allow delete: if isAuthor();
    }

    match /photos/{id} {
      allow read: if true;
      allow create: if isAuthorOnCreate()
        && optionalString('caption', 2000)
        && optionalString('url', 200000)
        && optionalString('type', 40);
      allow update: if isAuthor() || engagementOnly();
      allow delete: if isAuthor();
    }

    match /videos/{id} {
      allow read: if true;
      allow create: if isAuthorOnCreate()
        && optionalString('caption', 2000)
        && optionalString('url', 2000)
        && optionalString('type', 40);
      allow update: if isAuthor() || engagementOnly();
      allow delete: if isAuthor();
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && optionalString('postId', 120);
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;
    }

    match /likes/{id} {
      allow read: if true;
      allow create: if signedIn()
        && (
          (request.resource.data.userId == request.auth.uid)
          || (request.resource.data.user == request.auth.uid)
          || (request.resource.data.authorId == request.auth.uid)
        );
      allow delete: if signedIn()
        && (
          (resource.data.userId == request.auth.uid)
          || (resource.data.user == request.auth.uid)
          || (resource.data.authorId == request.auth.uid)
        );
      allow update: if false;
    }

    match /chats/{chatId} {
      allow read: if isChatMember()
        || (
          signedIn()
          && resource.data.campus == true
          && resource.data.campusKey is string
          && campusKeyOk(resource.data.campusKey)
        );

      allow create: if signedIn()
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() > 0
        && request.resource.data.memberIds.size() <= 50
        && optionalString('name', 80)
        && optionalString('peerName', 80)
        && optionalBool('group')
        && optionalBool('campus')
        && optionalString('campusKey', 40)
        && (
          request.resource.data.campus != true
          || (
            campusKeyOk(request.resource.data.campusKey)
            && chatId == request.resource.data.campusKey
          )
        );

      allow update: if signedIn() && (
        (
          isChatMember()
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['preview', 'lastMessage', 'updatedAt', 'unread', 'avatar', 'name'])
        )
        || (
          resource.data.campus == true
          && request.resource.data.campus == true
          && request.resource.data.campusKey == resource.data.campusKey
          && campusKeyOk(resource.data.campusKey)
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && !(request.auth.uid in resource.data.memberIds)
        )
        || (
          isChatMember()
          && request.resource.data.memberIds is list
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && !(request.auth.uid in request.resource.data.memberIds)
        )
      );

      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds is list
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;

        allow create: if signedIn()
          && get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds is list
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (
            !('kind' in request.resource.data)
            || request.resource.data.kind == 'text'
          );

        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reacts']);

        allow delete: if signedIn()
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /follows/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
