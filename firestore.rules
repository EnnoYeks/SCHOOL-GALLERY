rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function shortText(field, max) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() <= max;
    }

    match /posts/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }
    match /photos/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }
    match /videos/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }
    match /comments/{id} {
      allow read: if true;
      allow create: if signedIn() && shortText('text', 2000);
      allow update, delete: if signedIn();
    }
    match /likes/{id} {
      allow read: if true;
      allow create, delete: if signedIn();
    }

    match /chats/{chatId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() < 80;
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.senderId is string
          && request.resource.data.senderId.size() < 80
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacts']);
        allow delete: if false;
      }
    }

    match /presence/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
