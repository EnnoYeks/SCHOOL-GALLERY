{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://www.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebase.com https://*.firebasestorage.app wss://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.google-analytics.com https://*.google-analytics.com https://*.supabase.co wss://*.supabase.co https://hshs-r2-sign.ennoyeks.workers.dev; frame-src https://*.firebaseapp.com https://accounts.google.com" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "X-HSHS-Build", "value": "fast-first-paint" }
      ]
    },
    { "source": "/(.*).html", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/css/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ],
  "redirects": [
    { "source": "/index/more.html", "destination": "/more/", "permanent": true },
    { "source": "/index/about.html", "destination": "/about/", "permanent": true },
    { "source": "/index/profile.html", "destination": "/profile/", "permanent": true },
    { "source": "/index/settings.html", "destination": "/settings/", "permanent": true },
    { "source": "/index/gallery.html", "destination": "/gallery/", "permanent": true },
    { "source": "/index/photos.html", "destination": "/photos/", "permanent": true },
    { "source": "/index/videos.html", "destination": "/videos/", "permanent": true },
    { "source": "/index/buzz.html", "destination": "/buzz/", "permanent": true },
    { "source": "/index/chat.html", "destination": "/chat/", "permanent": true },
    { "source": "/index/polls.html", "destination": "/polls/", "permanent": true },
    { "source": "/index/memories.html", "destination": "/memories/", "permanent": true },
    { "source": "/index/notifications.html", "destination": "/notifications/", "permanent": true },
    { "source": "/index/saved.html", "destination": "/saved/", "permanent": true },
    { "source": "/index/search.html", "destination": "/search/", "permanent": true },
    { "source": "/index/admin.html", "destination": "/admin/", "permanent": true },
    { "source": "/index/login.html", "destination": "/login/", "permanent": true },
    { "source": "/index/contact.html", "destination": "/contact/", "permanent": true },
    { "source": "/index/edit-profile.html", "destination": "/edit-profile/", "permanent": true },
    { "source": "/index/spotlight.html", "destination": "/spotlight/", "permanent": true },
    { "source": "/index/trending.html", "destination": "/trending/", "permanent": true },
    { "source": "/more.html", "destination": "/more/", "permanent": true },
    { "source": "/about.html", "destination": "/about/", "permanent": true },
    { "source": "/profile.html", "destination": "/profile/", "permanent": true },
    { "source": "/gallery.html", "destination": "/gallery/", "permanent": true },
    { "source": "/photos.html", "destination": "/photos/", "permanent": true },
    { "source": "/videos.html", "destination": "/videos/", "permanent": true },
    { "source": "/buzz.html", "destination": "/buzz/", "permanent": true },
    { "source": "/chat.html", "destination": "/chat/", "permanent": true },
    { "source": "/login.html", "destination": "/login/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/vibe", "destination": "/buzz/" },
    { "source": "/vibe.html", "destination": "/buzz/" },
    { "source": "/clips", "destination": "/buzz/" },
    { "source": "/clips.html", "destination": "/buzz/" },
    { "source": "/shorts", "destination": "/buzz/" },
    { "source": "/shorts.html", "destination": "/buzz/" },
    { "source": "/studio", "destination": "/videos/" },
    { "source": "/studio.html", "destination": "/videos/" },
    { "source": "/contat", "destination": "/contact/" },
    { "source": "/contat.html", "destination": "/contact/" }
  ],
  "cleanUrls": false,
  "trailingSlash": true
}
