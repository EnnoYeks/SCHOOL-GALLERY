{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://www.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebase.com https://*.firebasestorage.app wss://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.google-analytics.com https://*.google-analytics.com; frame-src https://*.firebaseapp.com https://accounts.google.com" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "X-HSHS-Build", "value": "fast-first-paint" }
      ]
    },
    { "source": "/(.*).html", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }] },
    { "source": "/index/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/css/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ],
  "rewrites": [
    { "source": "/gallery.html", "destination": "/index/gallery.html" },
    { "source": "/gallery", "destination": "/index/gallery.html" },
    { "source": "/photos.html", "destination": "/index/photos.html" },
    { "source": "/photos", "destination": "/index/photos.html" },
    { "source": "/videos.html", "destination": "/index/videos.html" },
    { "source": "/videos", "destination": "/index/videos.html" },
    { "source": "/studio", "destination": "/index/videos.html" },
    { "source": "/studio.html", "destination": "/index/videos.html" },
    { "source": "/vibe", "destination": "/index/buzz.html" },
    { "source": "/vibe.html", "destination": "/index/buzz.html" },
    { "source": "/buzz.html", "destination": "/index/buzz.html" },
    { "source": "/buzz", "destination": "/index/buzz.html" },
    { "source": "/clips.html", "destination": "/index/buzz.html" },
    { "source": "/clips", "destination": "/index/buzz.html" },
    { "source": "/shorts.html", "destination": "/index/buzz.html" },
    { "source": "/shorts", "destination": "/index/buzz.html" },
    { "source": "/trending.html", "destination": "/index/trending.html" },
    { "source": "/trending", "destination": "/index/trending.html" },
    { "source": "/spotlight.html", "destination": "/index/spotlight.html" },
    { "source": "/spotlight", "destination": "/index/spotlight.html" },
    { "source": "/polls.html", "destination": "/index/polls.html" },
    { "source": "/polls", "destination": "/index/polls.html" },
    { "source": "/memories.html", "destination": "/index/memories.html" },
    { "source": "/memories", "destination": "/index/memories.html" },
    { "source": "/about.html", "destination": "/index/about.html" },
    { "source": "/about", "destination": "/index/about.html" },
    { "source": "/more.html", "destination": "/index/more.html" },
    { "source": "/more", "destination": "/index/more.html" },
    { "source": "/search.html", "destination": "/index/search.html" },
    { "source": "/search", "destination": "/index/search.html" },
    { "source": "/chat.html", "destination": "/index/chat.html" },
    { "source": "/chat", "destination": "/index/chat.html" },
    { "source": "/profile.html", "destination": "/index/profile.html" },
    { "source": "/profile", "destination": "/index/profile.html" },
    { "source": "/settings.html", "destination": "/index/settings.html" },
    { "source": "/settings", "destination": "/index/settings.html" },
    { "source": "/notifications.html", "destination": "/index/notifications.html" },
    { "source": "/notifications", "destination": "/index/notifications.html" },
    { "source": "/saved.html", "destination": "/index/saved.html" },
    { "source": "/saved", "destination": "/index/saved.html" },
    { "source": "/admin.html", "destination": "/index/admin.html" },
    { "source": "/admin", "destination": "/index/admin.html" },
    { "source": "/contact.html", "destination": "/index/contact.html" },
    { "source": "/contact", "destination": "/index/contact.html" },
    { "source": "/contat.html", "destination": "/index/contact.html" },
    { "source": "/contat", "destination": "/index/contact.html" },
    { "source": "/login.html", "destination": "/index/login.html" },
    { "source": "/login", "destination": "/index/login.html" },
    { "source": "/edit-profile.html", "destination": "/index/edit-profile.html" },
    { "source": "/edit-profile", "destination": "/index/edit-profile.html" },
    { "source": "/index/clips.html", "destination": "/index/buzz.html" }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
